    "CREATE OR REPLACE FUNCTION public.set_update_metadata()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\r\nDECLARE\r\n    v_user_id uuid;\r\nBEGIN\r\n    v_user_id := auth.uid();\r\n\r\n    IF v_user_id IS NULL THEN\r\n        RAISE EXCEPTION\r\n            'ログインユーザーを確認できません';\r\n    END IF;\r\n\r\n    NEW.updated_at := now();\r\n    NEW.version := OLD.version + 1;\r\n\r\n    NEW.created_at := OLD.created_at;\r\n    NEW.created_by := OLD.created_by;\r\n    NEW.household_id := OLD.household_id;\r\n\r\n    NEW.updated_by := v_user_id;\r\n\r\n    RETURN NEW;\r\nEND;\r\n$function$\n",
    "CREATE OR REPLACE FUNCTION public.is_household_member(p_household_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\n    SELECT EXISTS (\r\n        SELECT 1\r\n        FROM public.household_members AS hm\r\n        WHERE hm.household_id = p_household_id\r\n          AND hm.user_id = (SELECT auth.uid())\r\n    );\r\n$function$\n",
    "CREATE OR REPLACE FUNCTION public.validate_category_type()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\r\nDECLARE\r\n    v_type text;\r\n    v_expected text;\r\nBEGIN\r\n    IF NEW.category_id IS NULL THEN\r\n        RETURN NEW;\r\n    END IF;\r\n\r\n    IF TG_TABLE_NAME = 'events' THEN\r\n        v_expected := 'event';\r\n    ELSE\r\n        v_expected := 'note';\r\n    END IF;\r\n\r\n    SELECT type INTO v_type\r\n    FROM public.categories\r\n    WHERE id = NEW.category_id\r\n      AND household_id = NEW.household_id\r\n    FOR SHARE;\r\n\r\n    IF v_type IS DISTINCT FROM v_expected THEN\r\n        RAISE EXCEPTION\r\n            'カテゴリーの種類が一致しません';\r\n    END IF;\r\n\r\n    RETURN NEW;\r\nEND;\r\n$function$\n",
    "CREATE OR REPLACE FUNCTION public.protect_category_type()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\r\nBEGIN\r\n    IF NEW.household_id IS DISTINCT FROM OLD.household_id THEN\r\n        RAISE EXCEPTION\r\n            'カテゴリーの所属グループは変更できません';\r\n    END IF;\r\n\r\n    IF NEW.type IS DISTINCT FROM OLD.type THEN\r\n        IF EXISTS (\r\n            SELECT 1 FROM public.events\r\n            WHERE category_id = OLD.id\r\n        ) OR EXISTS (\r\n            SELECT 1 FROM public.notes\r\n            WHERE category_id = OLD.id\r\n        ) THEN\r\n            RAISE EXCEPTION\r\n                '使用中カテゴリーの種類は変更できません';\r\n        END IF;\r\n    END IF;\r\n\r\n    RETURN NEW;\r\nEND;\r\n$function$\n",
    "CREATE OR REPLACE FUNCTION public.set_creation_metadata()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\r\nDECLARE\r\n    v_user_id uuid;\r\nBEGIN\r\n    v_user_id := auth.uid();\r\n\r\n    -- ログインしていない場合は拒否\r\n    IF v_user_id IS NULL THEN\r\n        RAISE EXCEPTION\r\n            'ログインユーザーを確認できません';\r\n    END IF;\r\n\r\n    NEW.created_by := v_user_id;\r\n    NEW.updated_by := v_user_id;\r\n    NEW.created_at := now();\r\n    NEW.updated_at := now();\r\n    NEW.version := 1;\r\n\r\n    RETURN NEW;\r\nEND;\r\n$function$\n"
  ]
}
